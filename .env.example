# Copie para .env e ajuste os valores.
# O docker-compose.yml atual já define valores próprios; use este arquivo
# como referência para rodar a API fora do Docker.

# Banco (MySQL)
DB_URL=jdbc:mysql://localhost:3306/observa_cidade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=sua-senha
DB_DDL_AUTO=update

# JWT (mínimo 32 caracteres)
JWT_SECRET=troque-esta-chave-jwt-em-producao-com-32-caracteres
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=*

# Administrador inicial
APP_ADMIN_EMAIL=admin@observacidade.com
APP_ADMIN_SENHA=admin123

# Upload
UPLOAD_MAX_BYTES=5242880
